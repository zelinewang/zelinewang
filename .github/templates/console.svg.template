    <g><use href="#merged" transform="translate(46,633) scale(0.9)"/><text x="76" y="646" fill="#cdd5dd" font-weight="700">Fastify</text><text x="236" y="646" fill="#5fb88a">#6846</text><text x="326" y="646" fill="#a8b4c0">global or sticky RegExp parsers no longer miss on a stale lastIndex</text></g>
