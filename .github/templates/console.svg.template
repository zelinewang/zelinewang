<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 1380" role="img" aria-labelledby="title desc" preserveAspectRatio="xMidYMid meet">
  <title id="title">Console — Zane Wang's terminal session profile</title>
  <desc id="desc">A continuous terminal-window profile composed as one tmux session with 4 sections: identity, projects, fixes merged upstream in other people's repositories, and working method. Every line is static, verifiable content; live activity lives in GitHub's own contribution graph below the README.</desc>

  <defs>
    <pattern id="scanlines" x="0" y="0" width="2" height="3" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="2" y2="0" stroke="#0e1418" stroke-width="0.5" opacity="0.6"/>
    </pattern>
  </defs>

  <!-- ═══════ FRAME ═══════ -->
  <rect width="1200" height="1380" fill="#0a0e12"/>
  <rect width="1200" height="1380" fill="url(#scanlines)" opacity="0.4"/>
  <rect x="20" y="20" width="1160" height="1340" fill="#0d1217" stroke="#1c2530" stroke-width="0.5"/>

  <!-- ═══════ TOP STATUS BAR ═══════ -->
  <!-- No LIVE badge or date: nothing in this artwork is live data, and the old
       right-aligned date overlapped the badge in most monospace fonts. -->
  <rect x="20" y="20" width="1160" height="32" fill="#11181f"/>
  <line x1="20" y1="52" x2="1180" y2="52" stroke="#1c2530" stroke-width="0.5"/>
  <circle cx="42" cy="36" r="5" fill="#3a4a5a"/>
  <circle cx="60" cy="36" r="5" fill="#3a4a5a"/>
  <circle cx="78" cy="36" r="5" fill="#3a4a5a"/>
  <text x="106" y="40" fill="#7d8a96" font-family="ui-monospace, 'SF Mono', 'JetBrains Mono', monospace" font-size="11" letter-spacing="0.04em">~/zelinewang &#8212; tmux: profile (1/4)</text>

  <!-- ═══════ § 01 WHOAMI ═══════ -->
  <g font-family="ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, monospace" font-size="14">
    <text x="46" y="92" fill="#5a6573" font-size="10" letter-spacing="0.32em">§ &#160;01 &#160;WHOAMI</text>

    <text x="46" y="122"><tspan fill="#5fb88a">~/zelinewang</tspan><tspan fill="#7d8a96"> $</tspan><tspan fill="#cdd5dd"> whoami --verbose</tspan></text>

    <text x="46" y="176" fill="#cdd5dd" font-size="44" font-weight="500" letter-spacing="-0.02em">zane wang</text>

    <text x="46" y="208" font-size="15"><tspan fill="#5fb88a">builds AI systems</tspan><tspan fill="#5a6573">&#160;&#160;·&#160;&#160;</tspan><tspan fill="#5fb88a">builds open-source agent infrastructure</tspan></text>

    <text x="46" y="244" font-size="14"><tspan fill="#7d8a96">&#8594; current focus: </tspan><tspan fill="#cdd5dd">memory · delegation · evidence-driven workflows</tspan></text>

    <text x="46" y="270" font-size="14"><tspan fill="#7d8a96">&#8594; open-source: </tspan><tspan fill="#cdd5dd">claudemem</tspan><tspan fill="#5a6573"> · </tspan><tspan fill="#cdd5dd">handoff</tspan><tspan fill="#5a6573"> · </tspan><tspan fill="#cdd5dd">dev-orchestrator</tspan></text>

    <text x="46" y="296" font-size="14"><tspan fill="#7d8a96">&#8594; merged upstream: </tspan><tspan fill="#cdd5dd">zod · TanStack Query · fastify · axum · SQLx · goose · anyio</tspan></text>

    <text x="46" y="332" fill="#7d8a96" font-size="13">production background: AI evaluation · high-volume data · workflow automation</text>

    <line x1="46" y1="366" x2="1154" y2="366" stroke="#1c2530" stroke-width="0.5"/>
  </g>

  <!-- ═══════ § 02 PROJECTS ═══════ -->
  <g font-family="ui-monospace, 'SF Mono', 'JetBrains Mono', monospace" font-size="14">
    <text x="46" y="398" fill="#5a6573" font-size="10" letter-spacing="0.32em">§ &#160;02 &#160;PROJECTS</text>

    <text x="46" y="430"><tspan fill="#5fb88a">~/zelinewang</tspan><tspan fill="#7d8a96"> $</tspan><tspan fill="#cdd5dd"> ls projects/ --sort=track</tspan></text>

    <text x="46" y="458" fill="#5a6573" font-size="11" letter-spacing="0.06em">LANG</text>
    <text x="200" y="458" fill="#5a6573" font-size="11" letter-spacing="0.06em">NAME</text>
    <text x="470" y="458" fill="#5a6573" font-size="11" letter-spacing="0.06em">WHAT IT IS</text>
    <line x1="46" y1="466" x2="1154" y2="466" stroke="#1c2530" stroke-width="0.5"/>

    <g><text x="46" y="494" fill="#7d8a96">Go</text><text x="200" y="494" fill="#cdd5dd" font-weight="700">claudemem/</text><text x="470" y="494" fill="#a8b4c0">persistent memory for AI agents &#8212; FTS5 + semantic search, Go CLI</text></g>
    <g><text x="46" y="518" fill="#7d8a96">Shell</text><text x="200" y="518" fill="#cdd5dd" font-weight="700">handoff/</text><text x="470" y="518" fill="#a8b4c0">token-tiered delegation for agent harnesses</text></g>
    <g><text x="46" y="542" fill="#7d8a96">Shell</text><text x="200" y="542" fill="#cdd5dd" font-weight="700">dev-orchestrator/</text><text x="470" y="542" fill="#a8b4c0">one-command AI dev lifecycle &#8212; investigate &#8594; verify &#8594; ship</text></g>
    <g><text x="46" y="566" fill="#7d8a96">TypeScript</text><text x="200" y="566" fill="#cdd5dd" font-weight="700">postprism/</text><text x="470" y="566" fill="#a8b4c0">computer-use prototype with a front-end simulation</text></g>
    <g><text x="46" y="590" fill="#7d8a96">Python</text><text x="200" y="590" fill="#cdd5dd" font-weight="700">FireSight/</text><text x="470" y="590" fill="#a8b4c0">client-side wildfire map using NASA FIRMS + Leaflet</text></g>
    <g><text x="46" y="614" fill="#7d8a96">JavaScript</text><text x="200" y="614" fill="#cdd5dd" font-weight="700">dipole/</text><text x="470" y="614" fill="#a8b4c0">conversational deploy assistant for Netlify and Vercel</text></g>

    <text x="46" y="640" fill="#7d8a96" font-size="11"># 3 public agent tools · 3 public product experiments. links live below the artwork.</text>
    <line x1="46" y1="666" x2="1154" y2="666" stroke="#1c2530" stroke-width="0.5"/>
  </g>

  <!-- ═══════ § 03 UPSTREAM (merged fixes in other people's repositories) ═══════ -->
  <g font-family="ui-monospace, 'SF Mono', 'JetBrains Mono', monospace" font-size="14">
    <text x="46" y="698" fill="#5a6573" font-size="10" letter-spacing="0.32em">§ &#160;03 &#160;UPSTREAM</text>

    <text x="46" y="730"><tspan fill="#5fb88a">~/zelinewang</tspan><tspan fill="#7d8a96"> $</tspan><tspan fill="#cdd5dd"> gh search prs --author=@me --merged -- -user:zelinewang</tspan></text>

    <text x="46" y="758" fill="#5a6573" font-size="11" letter-spacing="0.06em">PROJECT</text>
    <text x="236" y="758" fill="#5a6573" font-size="11" letter-spacing="0.06em">LANG</text>
    <text x="380" y="758" fill="#5a6573" font-size="11" letter-spacing="0.06em">WHAT THE FIX DOES</text>
    <line x1="46" y1="766" x2="1154" y2="766" stroke="#1c2530" stroke-width="0.5"/>

    <g><text x="46" y="794" fill="#cdd5dd" font-weight="700">zod</text><text x="236" y="794" fill="#7d8a96">TypeScript</text><text x="380" y="794" fill="#a8b4c0">.catch() callbacks see the original input, not the coerced value</text></g>
    <g><text x="46" y="818" fill="#cdd5dd" font-weight="700">TanStack Query</text><text x="236" y="818" fill="#7d8a96">TypeScript</text><text x="380" y="818" fill="#a8b4c0">falsy combine() results are memoized instead of recomputed</text></g>
    <g><text x="46" y="842" fill="#cdd5dd" font-weight="700">fastify</text><text x="236" y="842" fill="#7d8a96">JavaScript</text><text x="380" y="842" fill="#a8b4c0">global/sticky RegExp content-type parsers stop missing matches</text></g>
    <g><text x="46" y="866" fill="#cdd5dd" font-weight="700">axum</text><text x="236" y="866" fill="#7d8a96">Rust</text><text x="380" y="866" fill="#a8b4c0">merged MethodRouters no longer repeat methods in the Allow header</text></g>
    <g><text x="46" y="890" fill="#cdd5dd" font-weight="700">SQLx</text><text x="236" y="890" fill="#7d8a96">Rust</text><text x="380" y="890" fill="#a8b4c0">pre-1970 SQLite REAL datetimes decode the right sub-second value</text></g>
    <g><text x="46" y="914" fill="#cdd5dd" font-weight="700">goose</text><text x="236" y="914" fill="#7d8a96">Rust</text><text x="380" y="914" fill="#a8b4c0">a custom model can be the default for new chats</text></g>
    <g><text x="46" y="938" fill="#cdd5dd" font-weight="700">anyio</text><text x="236" y="938" fill="#7d8a96">Python</text><text x="380" y="938" fill="#a8b4c0">CapacityLimiter stops over-granting tokens when resized</text></g>
    <g><text x="46" y="962" fill="#cdd5dd" font-weight="700">tenacity</text><text x="236" y="962" fill="#7d8a96">Python</text><text x="380" y="962" fill="#a8b4c0">wait_exponential no longer crashes when its ratio underflows</text></g>
    <g><text x="46" y="986" fill="#cdd5dd" font-weight="700">feast</text><text x="236" y="986" fill="#7d8a96">Python</text><text x="380" y="986" fill="#a8b4c0">feast[flink] installs again after conflicting PyArrow pins</text></g>
    <g><text x="46" y="1010" fill="#cdd5dd" font-weight="700">claude-hud</text><text x="236" y="1010" fill="#7d8a96">TypeScript</text><text x="380" y="1010" fill="#a8b4c0">3 PRs: model display options, effort display, schema fix</text></g>

    <text x="46" y="1036" fill="#7d8a96" font-size="11"># 12 PRs in 10 projects, each accepted and merged by the project maintainers. PR links live below the artwork.</text>
    <line x1="46" y1="1062" x2="1154" y2="1062" stroke="#1c2530" stroke-width="0.5"/>
  </g>

  <!-- ═══════ § 04 HOW I WORK ═══════ -->
  <g font-family="ui-monospace, 'SF Mono', 'JetBrains Mono', monospace" font-size="14">
    <text x="46" y="1094" fill="#5a6573" font-size="10" letter-spacing="0.32em">§ &#160;04 &#160;HOW &#160;I &#160;WORK</text>

    <text x="46" y="1126"><tspan fill="#5fb88a">~/zelinewang</tspan><tspan fill="#7d8a96"> $</tspan><tspan fill="#cdd5dd"> cat ~/.dev/how-i-work</tspan></text>

    <text x="46" y="1154" fill="#5a6573" font-size="11" letter-spacing="0.06em">STAGE</text>
    <text x="220" y="1154" fill="#5a6573" font-size="11" letter-spacing="0.06em">WHAT HAPPENS</text>
    <text x="640" y="1154" fill="#5a6573" font-size="11" letter-spacing="0.06em">GATE</text>
    <line x1="46" y1="1162" x2="1154" y2="1162" stroke="#1c2530" stroke-width="0.5"/>

    <g><text x="46" y="1190" fill="#5fb88a">investigate</text><text x="220" y="1190" fill="#a8b4c0">gather evidence before forming a theory</text><text x="640" y="1190" fill="#7d8a96">logs · code · docs</text></g>
    <g><text x="46" y="1214" fill="#5fb88a">plan</text><text x="220" y="1214" fill="#a8b4c0">scope, tier, pick the reversible path</text><text x="640" y="1214" fill="#7d8a96">cheapest signal first</text></g>
    <!-- execute is the "active" stage — a single quiet pulse keeps the terminal alive -->
    <g><text x="46" y="1238" fill="#5fb88a">execute</text><text x="220" y="1238" fill="#a8b4c0">write the test, then the code</text><text x="640" y="1238" fill="#7d8a96">TDD red &#8594; green</text>
      <circle cx="1120" cy="1233" r="3.5" fill="#5fb88a"><animate attributeName="opacity" values="1;0.35;1" dur="2.4s" repeatCount="indefinite"/></circle></g>
    <g><text x="46" y="1262" fill="#5fb88a">verify</text><text x="220" y="1262" fill="#a8b4c0">adversarial review against 7 rules</text><text x="640" y="1262" fill="#7d8a96">no fake green</text></g>
    <g><text x="46" y="1286" fill="#5fb88a">ship</text><text x="220" y="1286" fill="#a8b4c0">PR &#8594; CI &#8594; observe in production</text><text x="640" y="1286" fill="#7d8a96">done = observed</text></g>

    <text x="46" y="1320" fill="#7d8a96" font-size="11"># one brain plans and adjudicates; cheaper hands execute in parallel.</text>
    <text x="46" y="1340" fill="#7d8a96" font-size="11"># the real code behind this: dev-orchestrator (lifecycle) · handoff (delegation).</text>
  </g>
</svg>
