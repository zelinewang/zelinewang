    <g><use href="#merged" transform="translate(46,555) scale(0.9)"/><text x="76" y="568" fill="#cdd5dd" font-weight="700">SQLx</text><text x="236" y="568" fill="#5fb88a">#4340</text><text x="326" y="568" fill="#a8b4c0">pre-1970 SQLite REAL datetimes no longer decode up to two seconds off</text></g>
    <g><use href="#merged" transform="translate(46,581) scale(0.9)"/><text x="76" y="594" fill="#cdd5dd" font-weight="700">AnyIO</text><text x="236" y="594" fill="#5fb88a">#1223</text><text x="326" y="594" fill="#a8b4c0">asyncio CapacityLimiter no longer over-grants when total_tokens is raised</text></g>
