<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 1040" role="img" aria-labelledby="title desc" preserveAspectRatio="xMidYMid meet">
  <title id="title">Console — Zane Wang's terminal session profile</title>
  <desc id="desc">A terminal-window profile in three sections: identity, bug fixes merged upstream in other people's libraries, and the open-source agent tools Zane maintains. Every line is static, verifiable content; live activity lives in GitHub's own contribution graph below the README.</desc>

  <defs>
    <pattern id="scanlines" x="0" y="0" width="2" height="3" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="2" y2="0" stroke="#0e1418" stroke-width="0.5" opacity="0.6"/>
    </pattern>
  </defs>

  <!-- ═══════ FRAME ═══════ -->
  <rect width="1200" height="1040" fill="#0a0e12"/>
  <rect width="1200" height="1040" fill="url(#scanlines)" opacity="0.4"/>
  <rect x="20" y="20" width="1160" height="1000" fill="#0d1217" stroke="#1c2530" stroke-width="0.5"/>

  <!-- ═══════ TOP STATUS BAR ═══════ -->
  <!-- No LIVE badge or date: nothing in this artwork is live data, and the old
       right-aligned date overlapped the badge in most monospace fonts. -->
  <rect x="20" y="20" width="1160" height="32" fill="#11181f"/>
  <line x1="20" y1="52" x2="1180" y2="52" stroke="#1c2530" stroke-width="0.5"/>
  <circle cx="42" cy="36" r="5" fill="#3a4a5a"/>
  <circle cx="60" cy="36" r="5" fill="#3a4a5a"/>
  <circle cx="78" cy="36" r="5" fill="#3a4a5a"/>
  <text x="106" y="40" fill="#7d8a96" font-family="ui-monospace, 'SF Mono', 'JetBrains Mono', monospace" font-size="11" letter-spacing="0.04em">~/zelinewang &#8212; tmux: profile (1/3)</text>

  <!-- ═══════ § 01 WHOAMI ═══════ -->
  <g font-family="ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, monospace" font-size="14">
    <text x="46" y="92" fill="#5a6573" font-size="10" letter-spacing="0.32em">§ &#160;01 &#160;WHOAMI</text>

    <text x="46" y="122"><tspan fill="#5fb88a">~/zelinewang</tspan><tspan fill="#7d8a96"> $</tspan><tspan fill="#cdd5dd"> whoami --verbose</tspan></text>

    <text x="46" y="176" fill="#cdd5dd" font-size="44" font-weight="500" letter-spacing="-0.02em">zane wang</text>

    <text x="46" y="208" font-size="15"><tspan fill="#5fb88a">builds AI systems</tspan><tspan fill="#5a6573">&#160;&#160;·&#160;&#160;</tspan><tspan fill="#5fb88a">builds open-source agent infrastructure</tspan></text>

    <text x="46" y="244" font-size="14"><tspan fill="#7d8a96">&#8594; current focus: </tspan><tspan fill="#cdd5dd">memory · delegation · evidence-driven workflows</tspan></text>

    <text x="46" y="270" font-size="14"><tspan fill="#7d8a96">&#8594; open-source: </tspan><tspan fill="#cdd5dd">claudemem</tspan><tspan fill="#5a6573"> · </tspan><tspan fill="#cdd5dd">handoff</tspan><tspan fill="#5a6573"> · </tspan><tspan fill="#cdd5dd">dev-orchestrator</tspan></text>

    <text x="46" y="306" fill="#7d8a96" font-size="13">production background: AI evaluation · high-volume data · workflow automation</text>

    <line x1="46" y1="340" x2="1154" y2="340" stroke="#1c2530" stroke-width="0.5"/>
  </g>

  <!-- ═══════ § 02 UPSTREAM (bug fixes merged in other people's libraries) ═══════ -->
  <g font-family="ui-monospace, 'SF Mono', 'JetBrains Mono', monospace" font-size="14">
    <text x="46" y="372" fill="#5a6573" font-size="10" letter-spacing="0.32em">§ &#160;02 &#160;MERGED &#160;UPSTREAM</text>

    <text x="46" y="404"><tspan fill="#5fb88a">~/zelinewang</tspan><tspan fill="#7d8a96"> $</tspan><tspan fill="#cdd5dd"> gh search prs --author=@me --merged -- -user:zelinewang</tspan></text>

    <text x="46" y="432" fill="#5a6573" font-size="11" letter-spacing="0.06em">PROJECT</text>
    <text x="236" y="432" fill="#5a6573" font-size="11" letter-spacing="0.06em">LANG</text>
    <text x="380" y="432" fill="#5a6573" font-size="11" letter-spacing="0.06em">WHAT THE FIX DOES</text>
    <line x1="46" y1="440" x2="1154" y2="440" stroke="#1c2530" stroke-width="0.5"/>

    <g><text x="46" y="468" fill="#cdd5dd" font-weight="700">zod</text><text x="236" y="468" fill="#7d8a96">TypeScript</text><text x="380" y="468" fill="#a8b4c0">.catch() callbacks see the original input, not the coerced value</text></g>
    <g><text x="46" y="492" fill="#cdd5dd" font-weight="700">TanStack Query</text><text x="236" y="492" fill="#7d8a96">TypeScript</text><text x="380" y="492" fill="#a8b4c0">falsy combine() results are memoized instead of recomputed</text></g>
    <g><text x="46" y="516" fill="#cdd5dd" font-weight="700">fastify</text><text x="236" y="516" fill="#7d8a96">JavaScript</text><text x="380" y="516" fill="#a8b4c0">global/sticky RegExp content-type parsers stop missing matches</text></g>
    <g><text x="46" y="540" fill="#cdd5dd" font-weight="700">axum</text><text x="236" y="540" fill="#7d8a96">Rust</text><text x="380" y="540" fill="#a8b4c0">merged MethodRouters no longer repeat methods in the Allow header</text></g>
    <g><text x="46" y="564" fill="#cdd5dd" font-weight="700">SQLx</text><text x="236" y="564" fill="#7d8a96">Rust</text><text x="380" y="564" fill="#a8b4c0">pre-1970 SQLite REAL datetimes decode the right sub-second value</text></g>
    <g><text x="46" y="588" fill="#cdd5dd" font-weight="700">goose</text><text x="236" y="588" fill="#7d8a96">Rust</text><text x="380" y="588" fill="#a8b4c0">a custom model can be the default for new chats</text></g>
    <g><text x="46" y="612" fill="#cdd5dd" font-weight="700">anyio</text><text x="236" y="612" fill="#7d8a96">Python</text><text x="380" y="612" fill="#a8b4c0">CapacityLimiter stops over-granting tokens when resized</text></g>
    <g><text x="46" y="636" fill="#cdd5dd" font-weight="700">tenacity</text><text x="236" y="636" fill="#7d8a96">Python</text><text x="380" y="636" fill="#a8b4c0">wait_exponential no longer crashes when its ratio underflows</text></g>
    <g><text x="46" y="660" fill="#cdd5dd" font-weight="700">feast</text><text x="236" y="660" fill="#7d8a96">Python</text><text x="380" y="660" fill="#a8b4c0">feast[flink] installs again after conflicting PyArrow pins</text></g>
    <g><text x="46" y="684" fill="#cdd5dd" font-weight="700">claude-hud</text><text x="236" y="684" fill="#7d8a96">TypeScript</text><text x="380" y="684" fill="#a8b4c0">3 PRs: model display options, effort display, schema fix</text></g>

    <text x="46" y="712" fill="#7d8a96" font-size="11"># 12 PRs in 10 projects, each accepted and merged by the project maintainers. PR links live below the artwork.</text>
    <text x="46" y="730" fill="#7d8a96" font-size="11"># no issue existed for 7 of the 9 library fixes: the bug was found by reading the code, then fixed with a test.</text>
    <line x1="46" y1="756" x2="1154" y2="756" stroke="#1c2530" stroke-width="0.5"/>
  </g>

  <!-- ═══════ § 03 TOOLS (own open-source projects) ═══════ -->
  <g font-family="ui-monospace, 'SF Mono', 'JetBrains Mono', monospace" font-size="14">
    <text x="46" y="788" fill="#5a6573" font-size="10" letter-spacing="0.32em">§ &#160;03 &#160;TOOLS</text>

    <text x="46" y="820"><tspan fill="#5fb88a">~/zelinewang</tspan><tspan fill="#7d8a96"> $</tspan><tspan fill="#cdd5dd"> ls tools/ --sort=track</tspan></text>

    <text x="46" y="848" fill="#5a6573" font-size="11" letter-spacing="0.06em">LANG</text>
    <text x="200" y="848" fill="#5a6573" font-size="11" letter-spacing="0.06em">NAME</text>
    <text x="470" y="848" fill="#5a6573" font-size="11" letter-spacing="0.06em">WHAT IT IS</text>
    <line x1="46" y1="856" x2="1154" y2="856" stroke="#1c2530" stroke-width="0.5"/>

    <g><text x="46" y="884" fill="#7d8a96">Go</text><text x="200" y="884" fill="#cdd5dd" font-weight="700">claudemem/</text><text x="470" y="884" fill="#a8b4c0">persistent memory for AI agents &#8212; FTS5 + semantic search, Go CLI</text></g>
    <g><text x="46" y="908" fill="#7d8a96">Shell</text><text x="200" y="908" fill="#cdd5dd" font-weight="700">handoff/</text><text x="470" y="908" fill="#a8b4c0">token-tiered delegation for agent harnesses, with its evaluation</text></g>
    <g><text x="46" y="932" fill="#7d8a96">Shell</text><text x="200" y="932" fill="#cdd5dd" font-weight="700">dev-orchestrator/</text><text x="470" y="932" fill="#a8b4c0">one-command AI dev lifecycle &#8212; investigate &#8594; verify &#8594; ship</text></g>

    <text x="46" y="958" fill="#7d8a96" font-size="11"># the tools behind how the fixes above were found, tested and shipped.</text>

    <!-- closing prompt with a blinking cursor, inside the window frame -->
    <text x="46" y="1000"><tspan fill="#5fb88a">~/zelinewang</tspan><tspan fill="#7d8a96"> $</tspan></text>
    <rect x="190" y="988" width="9" height="14" fill="#e8b063">
      <animate attributeName="opacity" values="1;1;0;0" keyTimes="0;0.5;0.5;1" dur="1.0s" repeatCount="indefinite"/>
    </rect>
  </g>
</svg>
