.impeccable.md
design-options/
node_modules/
.DS_Store

# Rendered profile hero and its phone layout — build artifacts. render-profile.mjs
# writes them and refresh-stats.yml publishes them to the stats-output branch, which
# the README hero <picture> is served from; they are never committed to main.
assets/profile.svg
assets/profile-phone.svg

# Secrets — never commit. Real secrets live in ~/.config/secrets.env
# (outside repo) and as GitHub Actions repo secrets. These globs are
# belt-and-suspenders in case a future script ever writes one in-repo.
.env
.env.*
!.env.example
*.secret
*.secrets
secrets.env
*.pem
*.key
